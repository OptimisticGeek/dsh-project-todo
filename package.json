{
  "name": "@local/dsh-project-todo",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness 项目待办：里程碑/阶段/任务三层、依赖与就绪、开工简报；数据在 docs/ptodo/*.json；Web 看板 + 全局 ptodo CLI + 内置纯 JS Excel 导出（总览图表 + 任务明细，无 Python 依赖）",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/OptimisticGeek/dsh-project-todo.git"
  },
  "homepage": "https://github.com/OptimisticGeek/dsh-project-todo#readme",
  "bugs": {
    "url": "https://github.com/OptimisticGeek/dsh-project-todo/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/*.mjs\""
  },
  "bin": {
    "ptodo": "./bin/ptodo.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "bin",
    "lib/*.js",
    "lib/cli/*.mjs",
    "skill",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}


