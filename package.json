{
  "name": "dsh-project-task",
  "version": "3.1.2",
  "type": "module",
  "description": "DeepSeek Harness 项目待办：里程碑/阶段/任务三层、依赖与就绪、开工简报；数据在 docs/ptask/*.json；Web 看板 + 全局 ptask CLI + 内置纯 JS Excel 导出（总览图表 + 任务明细，无 Python 依赖）",
  "license": "Apache-2.0",
  "author": "OptimisticGeek",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "todo",
    "project-management",
    "cli",
    "ptask"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/OptimisticGeek/dsh-project-task.git"
  },
  "homepage": "https://github.com/OptimisticGeek/dsh-project-task#readme",
  "bugs": {
    "url": "https://github.com/OptimisticGeek/dsh-project-task/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.5-rc.2"
  },
  "scripts": {
    "test": "node --test"
  },
  "bin": {
    "ptask": "./bin/ptask.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "bin",
    "lib/*.js",
    "lib/cli/*.mjs",
    "templates/*.html",
    "skill",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
